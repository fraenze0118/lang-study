{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "paths": {
      "node:test": ["./scripts/node-test-shim.d.ts"],
      "node:assert/strict": ["./scripts/node-test-shim.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
